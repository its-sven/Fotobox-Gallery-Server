# --- Pflicht ---------------------------------------------------------------
# Admin-Passwort für /Admin (ohne eigenes Passwort bleibt der Admin gesperrt)
ADMIN_PASSWORD=BitteUnbedingtAendern
# Lange Zufallszeichenfolge, z. B. erzeugen mit: openssl rand -hex 32
SESSION_SECRET=BitteEineSehrLangeZufaelligeZeichenfolgeEintragen

# --- Server ----------------------------------------------------------------
# Benutzer/Gruppe, als die die App läuft (am besten derselbe Benutzer, der die Fotos hochlädt: id -u / id -g)
PUID=1000
PGID=1000
# Datenordner auf dem Server
DATA_PATH=/opt/fotobox
# true, sobald die Seite per HTTPS (Reverse Proxy) erreichbar ist
COOKIE_SECURE=true
TZ=Europe/Berlin
# Optional: feste Adresse für Links/QR-Codes, z. B. https://fotos.example.com
PUBLIC_BASE_URL=

# --- Aussehen --------------------------------------------------------------
SITE_EYEBROW=Fotobox
SITE_TITLE=Fotobox Galerie
CREDIT_NAME=Sven Würth
CREDIT_URL=https://svenw.de

# --- Leistung --------------------------------------------------------------
# Vorschaubilder im Hintergrund erzeugen, sobald neue Fotos ankommen
PREGENERATE=true
