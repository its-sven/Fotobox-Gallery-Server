{
  "name": "fotobox-gallery-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "DATA_ROOT=./data ADMIN_PASSWORD=dev COOKIE_SECURE=false node --watch server.js",
    "check": "node --check server.js && for f in src/*.js src/**/*.js public/js/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
